rules_version = '2';
// ============================================================
// Tentacalendar 2.0 — firestore.rules
// Version 1.2.1 — A HELPER MAY DELETE WHAT A HELPER MADE. Jake, on 1.2.0's
// blanket no-delete: "I make something for Katie, but it's dumb, so I need
// to delete it." Correct, and it cost nothing: every creator in store.js
// already stamps createdBy: whoami(), so the rule had a field to stand on
// and no app change was needed. See note 2a.
// (prev) Version 1.2.0 — THE CATCH-ALL WAS GRANTING MORE THAN IT LOOKED
// LIKE, and a fourth role ("helper") now exists. Both are explained below.
// (prev) Version 1.1.1 — E34 FIX: a rule matching on the document ID could
// never have secured a QUERY. (prev) 1.1.0 — dependent workspaces (E32/E33/E34).
//
// ⚠️ WHAT CHANGED FROM 1.1.1 — READ BOTH, THE FIRST IS A HOLE
//
//   1. THE `{subcollection}` CATCH-ALL ALSO MATCHED `members` AND
//      `activity`, AND FIRESTORE UNIONS ITS ALLOW RULES.
//
//      1.1.1 ended with:
//
//        match /{subcollection}/{docId} {
//          allow write: if canWrite(wsId);      // owner OR editor
//        }
//
//      That block sits at the same depth as `match /members/{email}` and
//      `match /activity/{docId}`, so a write to a member document matched
//      BOTH blocks. Firestore does not resolve that by specificity — there
//      is no "more specific rule wins". Every matching allow expression is
//      evaluated and access is granted if ANY of them is true. A narrow
//      rule can never take back what a broad one has already given.
//
//      Consequences, both live in 1.1.1:
//        · An EDITOR could write member documents. Not just their own row —
//          any row. Promote themselves to owner. Remove the person who
//          invited them. Every careful clause about who may hand out keys
//          was reachable around, one path over.
//        · `allow delete: if false` on activity was decorative. The
//          catch-all granted write, and write includes delete, so the
//          append-only log an owner would rely on for "who checked that
//          off" could be edited by anyone who could check things off.
//
//      FIXED by deleting the wildcard and naming the collections. The cost
//      is real and is accepted deliberately: a NEW collection now has no
//      rule and is denied by default until one is written for it. That is
//      the correct direction to fail. The wildcard failed the other way,
//      silently, and this is what it cost.
//
//      ⚠️ ITEM 9 (Katie's import) MUST RE-CHECK THIS LIST. If her export
//      carries a collection not named below, the import will be denied —
//      loudly, which is the point, but check before flip day rather than
//      during it.
//
//   2. A FOURTH ROLE: `helper`. Jake, 2026-07-27, on sharing his school
//      board with a colleague: "I'm going to want that person to be able
//      to see where I'm at, maybe check something off they helped with,
//      and then get out. That's very very different than being an owner."
//
//      It was also very different from being an EDITOR, which is what he
//      would have had to grant. An editor writes `tiers` and `settings`,
//      and those are where gcalCalendarId and mirrorCalendarId live — so
//      "can edit" included "can repoint this board at a different Google
//      Calendar." Nobody intended that; it was just the shape of one
//      catch-all covering documents of two very different kinds.
//
//      The split is now by WHAT A DOCUMENT IS, not by one blanket verb:
//
//        THE LIST      tasks, projects, sessions     helper and above
//        THE SETUP     tiers, settings, eventsCache  editor and above
//        THE PEOPLE    members, the workspace doc    owner only
//
//   2a. A HELPER MAY DELETE WHAT A HELPER MADE — and nothing else.
//
//      1.2.0 refused helpers delete outright, on the grounds that delete is
//      the only unrecoverable action in the app (restoreDoc replays from
//      the undo registry, which lives in one browser tab's memory and is
//      gone when they close it). That reasoning still holds for OTHER
//      PEOPLE'S documents. It never held for their own: someone who adds a
//      dumb task to your board and cannot take it back has to ask you to
//      clean up after them, which is worse for you than the delete was.
//
//      The rule is `resource.data.createdBy == me()`, and it required no
//      app change at all — addTask, addFollowUp, addProject,
//      addProjectWithStages, clockIn and logSession all already write
//      createdBy: whoami(), which is a lowercased email.
//
//      ⚠️ THE GUARD THAT MAKES IT SAFE, AND WITHOUT WHICH IT IS A BYPASS:
//      helpers can UPDATE. So without further care a helper could take any
//      task on the board, rewrite its createdBy to their own address, and
//      then delete it as "theirs" — the delete restriction undone by the
//      permission sitting next to it. createdBy is therefore IMMUTABLE on
//      update, for every role. Nothing legitimate rewrites it: restoreDoc
//      replays the original document, so the value it writes is the value
//      already there and the comparison passes.
//
//      Read with a default, so documents that predate the field are
//      handled correctly rather than crashing: a helper's address never
//      equals '', so legacy documents — including everything in Katie's
//      1.x export that was created before createdBy existed — are not
//      deletable by a helper. That is the right answer; they did not make
//      them.
//
//      PROJECT STAGES ARE ALREADY COVERED and need nothing here: a stage
//      is an element in the project document's stages[] array, so adding
//      or removing one is an UPDATE to that document, which helpers have.
//      The Pipeline TEMPLATE in Settings is a different thing and stays at
//      editor level — it is the mould every future project is cast from,
//      which is setup, not list work.
//
//   3. The workspace document's update rule now also admits isWsOwner().
//      Grants nothing new — that person can already DELETE the whole board
//      — and it removes a lockout shape where the holder of the deed has
//      no member row and therefore cannot rename their own house.
//
// (prev) Version 1.0.0 — the multi-workspace rules (design doc E1, E5, E19)
//
// WHAT CHANGED FROM 1.x (0.2.0):
//   · No allowlist. Anyone with a verified Google account may sign in and
//     create their OWN workspace. They cannot reach anyone else's, because
//     isolation is by PATH, not by field (E1). A user who is not a member
//     of a workspace cannot construct a query that touches it.
//   · Membership documents ARE the security boundary. Their existence
//     grants read; their `role` grants write.
//   · The activity log is append-only IN THE RULES — true as of 1.2.0,
//     and NOT true in 1.0.0–1.1.1, per note 1 above.
//   · secrets/ denies everything, always, so an OAuth refresh token can
//     never be read by any client — including its own owner's browser.
//
// ⚠️ BOOTSTRAP FIX (found 2026-07-25 while writing SETUP-2.0.md, against
//    the design doc's §5 sketch, which had a DEADLOCK):
//    §5 allowed writing members/{email} only if you were already an owner-
//    role MEMBER. So the very first member document could never be created,
//    and no workspace could ever be used by the person who made it.
//    Fixed by rooting membership in the WORKSPACE DOCUMENT's ownerEmail:
//    isWsOwner() reads workspaces/{wsId}.ownerEmail, which is set at
//    creation and locked against modification below. That is the root of
//    trust; member docs hang off it. This is why smoke.html exists — it
//    walks exactly this sequence and proves it before any real code.
//
// Paste into: Firebase Console → Firestore Database → Rules → Publish
//             SELECT ALL AND REPLACE. Appending is what took the site down
//             on 2026-07-12.
// Test in:    the Rules Playground, on that same screen, BEFORE Publish
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    // Lowercased throughout. Google returns canonical lowercase for gmail,
    // but custom domains carry whatever casing an admin provisioned — and
    // 2.0 will not always be gmail addresses. The literals and document ids
    // MUST be lowercase or this means nothing (same warning as 1.x 0.2.0).
    function me() {
      return request.auth.token.email.lower();
    }

    function wsDoc(wsId) {
      return /databases/$(database)/documents/workspaces/$(wsId);
    }
    function memberDoc(wsId) {
      return /databases/$(database)/documents/workspaces/$(wsId)/members/$(me());
    }

    // The root of trust: whoever the workspace document says owns it.
    // Survives having no member documents at all, which is what makes
    // workspace creation possible.
    function isWsOwner(wsId) {
      return signedIn() && get(wsDoc(wsId)).data.ownerEmail == me();
    }
    function isMember(wsId) {
      return signedIn() && exists(memberDoc(wsId));
    }
    function roleIn(wsId, roles) {
      return isMember(wsId) && get(memberDoc(wsId)).data.role in roles;
    }

    function canRead(wsId)  { return isMember(wsId) || isWsOwner(wsId); }

    // THE PEOPLE — keys and the house itself.
    function canAdmin(wsId) { return roleIn(wsId, ['owner']) || isWsOwner(wsId); }

    // THE SETUP — tiers, settings, the calendar ids. Configuration.
    function canSetUp(wsId) {
      return roleIn(wsId, ['owner', 'editor']) || isWsOwner(wsId);
    }

    // THE LIST — tasks, projects, sessions. The daily work of the board.
    function canWorkList(wsId) {
      return roleIn(wsId, ['owner', 'editor', 'helper']) || isWsOwner(wsId);
    }

    // Did I make this document? Read with a default so documents written
    // before createdBy existed — everything old in Katie's 1.x export —
    // answer no rather than erroring.
    function iMadeThis() {
      return resource.data.get('createdBy', '') == me();
    }

    // createdBy may never change, for anyone. Not bookkeeping: it is what
    // stops a helper relabelling somebody else's document as their own in
    // order to delete it (header note 2a). Nothing legitimate rewrites it —
    // restoreDoc replays the original document, so the value it writes is
    // the value already there.
    function creatorIntact() {
      return request.resource.data.get('createdBy', '')
          == resource.data.get('createdBy', '');
    }

    // ---- user profiles: yours and only yours ----
    match /users/{email} {
      allow read, write: if signedIn() && email == me();
    }

    // ---- OAuth refresh tokens: no client access, ever (E19) ----
    // Admin SDK bypasses rules, so the functions can still read them.
    // This clause ships even if path B is never built, so the collection
    // cannot be created by accident later.
    match /secrets/{docId} {
      allow read, write: if false;
    }

    // ---- "which houses do I hold a key to?" (E34) ----
    // The board switcher runs collectionGroup('members').where(email == me).
    // A collectionGroup query is NOT covered by rules nested under
    // /workspaces/{wsId}, so it needs this clause at the top level.
    //
    // ⚠️ 1.1.1 FIX — READ THIS BEFORE "SIMPLIFYING" IT BACK.
    // 1.1.0 wrote `match /{path=**}/members/{email}` with the condition
    // `email == me()`, reasoning that the document id IS the member's email
    // so only the asker's own rows could return. That reasoning is sound for
    // a GET of one named document and MEANINGLESS FOR A QUERY:
    //
    //   A query does not name documents. Firestore evaluates a list rule
    //   against the QUERY ITSELF, before any document is read, so the
    //   document-id wildcard is simply not bound — and the whole query is
    //   refused. Not filtered to nothing: REFUSED, as permission-denied.
    //
    // The rule for securing a list must therefore test a FIELD, and the
    // client query must filter on that same field so Firestore can prove
    // the result set is confined to what the rule permits. Member documents
    // carry `email` precisely so this works.
    //
    // Security is unchanged: `resource.data.email == me()` still admits only
    // rows describing the asker. Asking for somebody else's memberships
    // (where email == 'katie@…') is denied, because the rule compares
    // against the CALLER, not against the filter.
    //
    // READ ONLY, deliberately. It is the one clause that reaches across the
    // whole database, so it grants the smallest verb that answers the
    // question.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.email == me();
    }

    match /workspaces/{wsId} {
      allow read:   if canRead(wsId);
      allow create: if signedIn()
                    && request.resource.data.ownerEmail == me();
      // ownerEmail is LOCKED after creation — otherwise an owner-role member
      // could rewrite it and seize the root of trust. isWsOwner is admitted
      // alongside owner-role because the holder of the deed can already
      // delete this document outright; refusing them a rename was a lockout
      // shape, not a protection.
      allow update: if canAdmin(wsId)
                    && request.resource.data.ownerEmail == resource.data.ownerEmail;
      allow delete: if isWsOwner(wsId);

      // ---------- THE PEOPLE ----------

      match /members/{email} {
        allow read:   if canRead(wsId);
        // The workspace owner adds and removes anyone — including the very
        // first member (themselves), which is the deadlock fix.
        allow write:  if canAdmin(wsId);

        // Anyone may remove THEMSELVES from a workspace they were added to —
        // UNLESS they are flagged as a minor on that workspace (E33).
        // Without this, Nico's exit from his own board is a self-service
        // button, and what he lands on afterwards is a brand-new workspace
        // that HE owns and his parents have never heard of. Note `minor` is
        // read with a default, so the ~all rows that lack the field are
        // unaffected and no migration is needed.
        allow delete: if signedIn() && email == me()
                      && resource.data.get('minor', false) == false;

        // …and may edit their own row: display name, the `hidden` flag that
        // keeps a board out of their own switcher — but never their own
        // role, and never their own minor flag. That second clause is the
        // one that matters: a guard a child can switch off is decoration.
        allow update: if signedIn() && email == me()
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.get('minor', false)
                         == resource.data.get('minor', false);
      }

      // ---------- THE LOG ----------

      match /activity/{docId} {
        allow read:   if canRead(wsId);
        // Viewers may write here and NOWHERE else — that is how kudos work
        // (E10): a viewer can cheer, and cannot check anything off.
        allow create: if canRead(wsId)
                      && request.resource.data.actor == me();
        // Append-only: only `reactions` may change after the fact. As of
        // 1.2.0 this is actually true — see note 1 in the header.
        allow update: if canRead(wsId)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['reactions']);
        allow delete: if false;
      }

      // ---------- THE LIST ----------
      // A helper works these: create, update, and delete their OWN. See
      // header notes 2 and 2a. The three clauses are deliberately identical
      // — a difference between them would be a difference nobody meant.

      match /tasks/{docId} {
        allow read:   if canRead(wsId);
        allow create: if canWorkList(wsId);
        allow update: if canWorkList(wsId) && creatorIntact();
        allow delete: if canSetUp(wsId)
                      || (canWorkList(wsId) && iMadeThis());
      }

      match /projects/{docId} {
        allow read:   if canRead(wsId);
        allow create: if canWorkList(wsId);
        allow update: if canWorkList(wsId) && creatorIntact();
        allow delete: if canSetUp(wsId)
                      || (canWorkList(wsId) && iMadeThis());
      }

      match /sessions/{docId} {
        allow read:   if canRead(wsId);
        allow create: if canWorkList(wsId);
        allow update: if canWorkList(wsId) && creatorIntact();
        allow delete: if canSetUp(wsId)
                      || (canWorkList(wsId) && iMadeThis());
      }

      // ---------- THE SETUP ----------
      // tiers carry gcalCalendarId; settings/config carries mirrorCalendarId,
      // the carryover hour and the poll interval. These are the board's
      // wiring, and changing them changes what the hourly function does to
      // somebody's actual Google Calendar. Editor and above.

      match /tiers/{docId} {
        allow read:  if canRead(wsId);
        allow write: if canSetUp(wsId);
      }

      match /settings/{docId} {
        allow read:  if canRead(wsId);
        allow write: if canSetUp(wsId);
      }

      // Written by the function through the Admin SDK, which bypasses rules
      // entirely; the client only ever subscribes. Kept writable at editor
      // level rather than denied outright so a future client-side refresh
      // does not need a rules change to exist.
      match /eventsCache/{docId} {
        allow read:  if canRead(wsId);
        allow write: if canSetUp(wsId);
      }

      // ⚠️ NO CATCH-ALL, ON PURPOSE. See header note 1. A collection that is
      // not named above is denied. If you add one, add its clause here and
      // decide deliberately which of the three tiers it belongs to.
    }
  }
}
